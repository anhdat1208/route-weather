# GraphHopper (sign up at https://www.graphhopper.com — free, no credit card)
GRAPHHOPPER_API_KEY=
GRAPHHOPPER_BASE_URL=https://graphhopper.com/api/1

# Open-Meteo (no key required)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# RainViewer radar (no key required — https://www.rainviewer.com/api.html)
RAINVIEWER_API_URL=https://api.rainviewer.com
RADAR_REFRESH_INTERVAL_SECONDS=300
RADAR_STALE_AFTER_SECONDS=900
CACHE_TTL_RADAR=120

# PostgreSQL
DATABASE_URL=postgresql://routeweather:routeweather@db:5432/routeweather
POSTGRES_DB=routeweather
POSTGRES_USER=routeweather
POSTGRES_PASSWORD=routeweather

# Cache TTL (seconds)
CACHE_TTL_ROUTE=86400
CACHE_TTL_GEOCODE=604800
CACHE_TTL_WEATHER=1800

# Route Weather Engine
ROUTE_WEATHER_SAMPLE_INTERVAL_KM=10
ROUTE_WEATHER_MAX_POINTS=20
ROUTE_WEATHER_MIN_POINTS=5

# Risk thresholds
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MODERATE=40
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_VERY_HIGH=80

# Backend (production: thêm URL Vercel, ví dụ https://route-weather.vercel.app)
CORS_ORIGINS=http://localhost:3000

# Frontend (production: trỏ tới URL backend, ví dụ https://route-weather-api.onrender.com)
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
